FROM gcr.io/google.com/cloudsdktool/google-cloud-cli:576.0.0-slim AS sdk
COPY --from=ghcr.io/astral-sh/uv:0.5.9 /uv /bin/uv
RUN gcloud storage ls
FROM python:3.13-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends google-cloud-cli \
    && rm -rf /var/lib/apt/lists/*
FROM python:3.13-slim AS runtime
ENV CLOUDSDK_CORE_CUSTOM_CA_CERTS_FILE=/etc/ssl/certs/ca-certificates.crt
COPY --from=sdk /google-cloud-sdk /google-cloud-sdk
FROM alpine:3.20 AS plain
